---
import "../styles/global.css";
import Atmosphere from "../components/Atmosphere.astro";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "book" | "article";
}

const {
	title = "Kalon Solutions",
	description,
	ogImage,
	ogType = "website",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absoluteOgImage = ogImage
	? new URL(ogImage, Astro.site ?? Astro.url).toString()
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:url" content={canonicalUrl} />
		{description && <meta property="og:description" content={description} />}
		{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

		<meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
	</head>
	<body
		class="min-h-screen bg-[#2c1f17] font-sans text-gray-900 antialiased selection:bg-blue-200"
	>
		<!-- The desk stays put with the window and its light; only the sheet slides. -->
		<div class="desk pointer-events-none fixed inset-0" aria-hidden="true"></div>
		<div class="paper relative mx-3 my-3 rounded-[3px] bg-gray-50 md:mx-auto md:my-16 md:max-w-3xl">
			<!-- Paper grain, part of the sheet so it travels with it -->
			<div
				class="pointer-events-none absolute inset-0 rounded-[inherit] opacity-[0.03]"
				style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"
				aria-hidden="true"
			>
			</div>
			<div class="relative">
				<slot />
			</div>
		</div>
		<Atmosphere />
	</body>
</html>

<style>
	.desk {
		background: url("../assets/desk.svg") 0 0 / 1200px 800px;
	}

	/* Light comes from the top left, so the sheet's shadow falls down and to
	   the right. The inset line is the paper's lit edge. */
	.paper {
		box-shadow:
			inset 1px 1px 0 rgb(255 255 255 / 0.7),
			0 1px 2px rgb(20 12 6 / 0.35),
			4px 8px 16px -4px rgb(20 12 6 / 0.45),
			18px 36px 60px -18px rgb(20 12 6 / 0.6);
	}
</style>
