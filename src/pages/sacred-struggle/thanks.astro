---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Your copy of Sacred Struggle" ogImage="/og/sacred-struggle.jpg" ogType="book" noIndex>
    <main class="mx-auto max-w-xl px-6 pb-12 pt-10 text-center sm:px-10 sm:pb-16 sm:pt-12">
        <a href="/sacred-struggle" class="text-sm text-blue-700 underline decoration-blue-300 underline-offset-4 hover:text-orange-700">
            Back to the book
        </a>

        <img
            src="/book-cover.jpeg"
            alt="Sacred Struggle by Marcel Samyn"
            width="1200"
            height="1800"
            class="mx-auto mb-9 mt-8 h-auto w-32 -rotate-3 rounded-[2px] shadow-[2px_2px_0_#d9c5a3,10px_20px_32px_-12px_#271b16aa] sm:w-40"
        />

        <p id="order-status" class="mb-3 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-orange-700">
            Sacred Struggle · EPUB
        </p>
        <h1 id="order-title" class="text-balance font-serif text-4xl font-semibold tracking-tight text-blue-800 sm:text-5xl">
            Find your copy
        </h1>
        <p id="order-note" class="mx-auto mt-4 max-w-sm text-pretty text-lg leading-relaxed text-gray-700">
            Open the download link from your order email to get your copy of the book.
        </p>

        <div id="order-download" class="mt-7" hidden>
            <a class="book-action">Download EPUB <span aria-hidden="true">↓</span></a>
            <p class="mt-3 text-sm text-gray-600">Open the file in an EPUB reader.</p>
        </div>

        <footer class="mx-auto mt-9 max-w-sm border-t border-gray-200 pt-5 text-sm text-gray-600">
            Need help with your order?
            <a href="mailto:marcel@samyn.co" class="text-blue-700 underline decoration-blue-300 underline-offset-4 hover:text-orange-700">
                Email Marcel
            </a>
        </footer>
    </main>
</Layout>
