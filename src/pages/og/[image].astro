---
// Social sharing images, drawn as real scenes so they share the site's light.
// Each route is screenshotted at 1200×630 into public/og/<image>.jpg with
// reduced motion on, which renders one still frame. They only exist in dev.
import "../../styles/global.css";
import Atmosphere from "../../components/Atmosphere.astro";

export function getStaticPaths() {
	if (!import.meta.env.DEV) return [];
	return [
		{ params: { image: "kalon-solutions" }, props: { seed: 5 } },
		{ params: { image: "sacred-struggle" }, props: { seed: 5 } },
	];
}

const { image } = Astro.params;
const { seed } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="robots" content="noindex" />
		<title>{image}</title>
		<!-- A seeded Math.random puts the light and dust in the same place on every capture. -->
		<script is:inline define:vars={{ seed }}>
			let state = seed;
			Math.random = () => {
				state = (state + 0x6d2b79f5) | 0;
				let t = Math.imul(state ^ (state >>> 15), 1 | state);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		</script>
	</head>
	<body class="desk relative h-[630px] w-[1200px] overflow-hidden font-sans antialiased">
		{
			image === "kalon-solutions" && (
				<div class="paper absolute top-[76px] left-[170px] h-[640px] w-[860px] -rotate-1 rounded-[3px] px-[88px] pt-[84px]">
					<h1 class="font-serif text-[80px] leading-none font-semibold tracking-tight text-blue-800">
						Kalon Solutions
					</h1>
					<p class="mt-9 text-[34px] leading-snug text-gray-700">
						Engineer. Designer. Speaker.
						<br />I build things that change how people feel.
					</p>
					<p class="mt-8 text-[24px] text-blue-600 underline decoration-blue-300 underline-offset-4">
						Marcel Samyn
					</p>
					<p class="absolute top-[470px] right-[88px] left-[88px] border-t border-gray-200 pt-5 text-[19px] text-gray-500">
						kalon.solutions
					</p>
				</div>
			)
		}
		{
			image === "sacred-struggle" && (
				<>
					<div class="paper absolute top-[86px] left-[88px] h-[640px] w-[720px] rotate-1 rounded-[3px] px-[76px] pt-[80px]">
						<p class="text-[17px] tracking-[0.22em] text-orange-700 uppercase">A book by Marcel Samyn</p>
						<h1 class="mt-5 font-serif text-[84px] leading-[0.95] font-semibold tracking-tight text-blue-800">
							Sacred
							<br />
							Struggle
						</h1>
						<p class="mt-7 max-w-[400px] font-serif text-[31px] leading-snug text-gray-600 italic">
							Finding meaning in a world run by machines
						</p>
					</div>
					<div class="book absolute top-[62px] right-[132px] w-[330px] -rotate-[4deg]">
						<img src="/book-cover.jpeg" alt="" width="1200" height="1800" class="block h-auto w-full rounded-sm" />
					</div>
				</>
			)
		}
		<Atmosphere />
	</body>
</html>

<style>
	/* Keep Astro's dev toolbar out of the capture. */
	:global(astro-dev-toolbar) {
		display: none;
	}

	/* A paperback set down on the desk: a sliver of page block on the side
	   away from the window, and a cast shadow like the paper's. */
	.book {
		border-radius: 2px;
		box-shadow:
			3px 3px 0 -1px var(--color-gray-100),
			4px 4px 0 -1px rgb(20 12 6 / 0.25),
			0 1px 3px rgb(10 15 30 / 0.45),
			8px 12px 18px -4px rgb(10 15 30 / 0.55),
			24px 40px 64px -16px rgb(10 15 30 / 0.6);
	}
</style>
