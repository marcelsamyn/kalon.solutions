---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { BookCover } from "../components/BookCover";
import { FollowAlongForm } from "../components/FollowAlongForm";

const MAILERLITE_FORM_ACTION =
    "https://assets.mailerlite.com/jsonp/124930/forms/184979158372189643/subscribe";
const SUBTITLE = "Finding meaning in a world run by machines";
const LAUNCH_DATE_LABEL = "November 11, 2026";
const ebookCheckoutUrl: string | undefined = import.meta.env.SACRED_STRUGGLE_CHECKOUT_URL;
if (ebookCheckoutUrl && new URL(ebookCheckoutUrl).protocol !== "https:") {
    throw new Error("SACRED_STRUGGLE_CHECKOUT_URL must use HTTPS.");
}

const description =
    "Sacred Struggle: a book by Marcel Samyn on AI, ease, and what happens to humans when intelligence and effort become cheap.";
---

<Layout
    title="Sacred Struggle — a book by Marcel Samyn"
    description={description}
    ogImage="/og/sacred-struggle.jpg"
    ogType="book"
>
    <script is:inline>
        (() => {
            const launch = Date.parse("2026-11-10T23:00:00Z");
            const update = () => {
                const remaining = launch - Date.now();
                document.documentElement.classList.toggle("before-book-launch", remaining > 0);
                document.documentElement.classList.add("book-launch-ready");
                if (remaining > 0) setTimeout(update, Math.min(remaining, 2147483647));
            };
            update();
        })();
    </script>
    <style is:global>
        .book-before-launch { display: none; }
        .before-book-launch .book-before-launch { display: block; }
        .book-after-launch { display: none; }
        .book-launch-ready:not(.before-book-launch) .book-after-launch { display: block; }
        .book-launch-ready .book-no-js { display: none; }
        .store-link { color: var(--color-blue-600); text-decoration: underline; text-decoration-color: var(--color-blue-300); text-underline-offset: 3px; }
        .store-link:hover { color: var(--color-orange-600); text-decoration-color: var(--color-orange-300); }
    </style>
    <main class="mx-auto max-w-2xl px-6 py-20 md:py-28">
        <!-- Hero -->
        <header class="mb-20 text-center md:mb-28">
            <!-- Same artwork as the book itself. /book-cover.jpeg is the flat render. -->
            <div class="mx-auto mb-12 w-56 md:w-72">
                <BookCover class="block h-auto w-full" client:load />
            </div>

            <p
                class="book-before-launch mb-4 font-sans text-xs uppercase tracking-[0.22em] text-orange-700"
            >
                Coming {LAUNCH_DATE_LABEL}
            </p>
            <h1
                class="font-serif text-5xl font-semibold tracking-tight text-blue-800 md:text-6xl"
            >
                Sacred Struggle
            </h1>
            <p
                class="mt-4 font-serif text-xl italic text-gray-600 md:text-2xl text-balance"
            >
                {SUBTITLE}
            </p>
            <p class="book-before-launch mx-auto mt-6 max-w-md text-lg leading-relaxed text-gray-700">
                The Introduction right away, then a few pieces as I go&mdash;and
                one email the day the book is out.
            </p>

            <div class="book-before-launch mx-auto max-w-md">
                <FollowAlongForm
                    formId="hero-signup"
                    action={MAILERLITE_FORM_ACTION}
                    contactEmail="marcel@samyn.co"
                    client:load
                />
            </div>

            <section class="mt-14 text-left" aria-labelledby="stores-heading">
                <h2 id="stores-heading" class="text-center font-serif text-2xl font-semibold text-blue-700">
                    <span class="book-before-launch">Pre-order the book</span>
                    <span class="book-after-launch">Order the book</span>
                    <span class="book-no-js">Find the book</span>
                </h2>
                <p class="mt-3 text-center text-gray-600">Choose a store in your region. Availability may vary.</p>
                <h3 class="mt-8 font-serif text-xl font-semibold text-blue-800">Paperback</h3>
                <div class="mt-4 grid gap-6 sm:grid-cols-2">
                    <div>
                        <h4 class="font-serif text-lg font-semibold text-blue-800">Belgium</h4>
                        <ul class="mt-2 space-y-2">
                            <li><a class="store-link" href="https://www.bol.com/be/nl/p/sacred-struggle-finding-meaning-in-a-world-run-by-machines/9300000438504786/">bol</a></li>
                            <li><a class="store-link" href="https://www.amazon.com.be/dp/9083807800">Amazon Belgium</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-serif text-lg font-semibold text-blue-800">United States</h4>
                        <ul class="mt-2 space-y-2">
                            <li><a class="store-link" href="https://www.amazon.com/dp/9083807800">Amazon.com</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-serif text-lg font-semibold text-blue-800">Canada</h4>
                        <ul class="mt-2 space-y-2">
                            <li><a class="store-link" href="https://www.amazon.ca/dp/9083807800">Amazon.ca</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-serif text-lg font-semibold text-blue-800">United Kingdom</h4>
                        <ul class="mt-2 space-y-2">
                            <li><a class="store-link" href="https://www.amazon.co.uk/dp/9083807800">Amazon.co.uk</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-serif text-lg font-semibold text-blue-800">Australia</h4>
                        <ul class="mt-2 space-y-2">
                            <li><a class="store-link" href="https://www.amazon.com.au/dp/9083807800">Amazon.com.au</a></li>
                        </ul>
                    </div>
                </div>
                <div class="mt-10 border-t border-blue-200 pt-6">
                    <h3 class="font-serif text-xl font-semibold text-blue-800">E-book</h3>
                    <ul class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2">
                        {ebookCheckoutUrl && (
                            <li>
                                <a class="book-action" href={ebookCheckoutUrl}>
                                    Buy EPUB directly <span aria-hidden="true">→</span>
                                </a>
                            </li>
                        )}
                        <li><a class="store-link" href="https://www.bol.com/be/nl/p/sacred-struggle-ebook/9300000441539572/">bol Belgium</a></li>
                        <li><a class="store-link" href="https://www.amazon.fr/dp/B0HLRC3D2T">Kindle Belgium</a></li>
                        <li><a class="store-link" href="https://www.amazon.com/dp/B0HLRC3D2T">Kindle US</a></li>
                        <li><a class="store-link" href="https://www.kobo.com/my/en/ebook/sacred-struggle-1">Kobo (select your country)</a></li>
                        <li><a class="store-link" href="https://play.google.com/store/books/details?id=tIwiEgAAQBAJ">Google Play Books</a></li>
                    </ul>
                </div>
            </section>
        </header>

        <!-- The hook -->
        <section class="mb-20 md:mb-28">
            <blockquote
                class="border-l-2 border-orange-300 pl-6 font-serif text-2xl leading-snug text-blue-800 md:text-3xl md:leading-snug"
            >
                When AI takes over our work, life and love&mdash;will we be
                happier?
            </blockquote>
        </section>

        <!-- What the book is about -->
        <section class="mb-20 md:mb-28">
            <h2 class="font-serif text-2xl font-semibold text-blue-700">
                About the book
            </h2>
            <div class="mt-6 space-y-5 text-lg leading-relaxed text-gray-700">
                <p>
                    The world is racing towards a giant leap in comfort,
                    abundance and pleasure. AI promises to solve our problems
                    faster and better than ever before, and all signs point to a
                    near future where it does. But what if ease is exactly what
                    is making us unhappy?
                </p>
                <p>
                    When agriculture took away our need for physical effort, we
                    eventually had to consciously stress our bodies through
                    sport to stay healthy. Now, with AI arriving for our minds,
                    we&rsquo;ll have to do the same. The struggles we are so
                    motivated to remove are precisely what give our lives
                    meaning.
                </p>
                <p>
                    You&rsquo;ll come away understanding large language models
                    from the inside out&mdash;no technical background
                    needed&mdash;and the latest neuroscience of happiness.
                    You&rsquo;ll see where AI helps, where it hurts, and how the
                    technology (and our society) should work if we want to move
                    toward greater fulfillment, not away from it.
                </p>
            </div>
        </section>

        <!-- What the emails are -->
        <section class="book-before-launch mb-20 md:mb-28">
            <h2 class="font-serif text-2xl font-semibold text-blue-700">
                What you&rsquo;ll get
            </h2>
            <ul class="mt-6 space-y-3 text-lg text-gray-700">
                <li class="flex gap-3">
                    <span
                        class="mt-3 h-1 w-1 shrink-0 rounded-full bg-orange-400"
                        aria-hidden="true"></span>
                    <span
                        ><strong class="font-medium text-gray-900"
                            >The Introduction right away</strong
                        >, then a few pieces as I go, sent straight to your
                        inbox as the book comes together.</span
                    >
                </li>
                <li class="flex gap-3">
                    <span
                        class="mt-3 h-1 w-1 shrink-0 rounded-full bg-orange-400"
                        aria-hidden="true"></span>
                    <span
                        ><strong class="font-medium text-gray-900"
                            >One email on release day</strong
                        >, so you hear about it the moment it&rsquo;s
                        out.</span
                    >
                </li>
                <li class="flex gap-3">
                    <span
                        class="mt-3 h-1 w-1 shrink-0 rounded-full bg-orange-400"
                        aria-hidden="true"></span>
                    <span
                        >Nothing else. No spam, no sharing your address with
                        anyone, and one click to leave whenever you
                        like.</span
                    >
                </li>
            </ul>
        </section>

        <!-- About the author -->
        <section class="mb-20 md:mb-28">
            <h2 class="font-serif text-2xl font-semibold text-blue-700">
                About the author
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-gray-700">
                I&rsquo;m <a
                    href="https://samyn.co"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 underline decoration-blue-300 underline-offset-2 transition-colors hover:text-orange-600 hover:decoration-orange-300"
                    >Marcel Samyn</a
                >&mdash;engineer, designer, and speaker. I build things that
                change how people feel, and I write at the intersection of
                technology, psychology, and what it means to live well.
            </p>
        </section>

        <!-- Signup repeat -->
        <section class="book-before-launch mx-auto max-w-md">
            <h2 class="font-serif text-2xl font-semibold text-blue-700">
                Read the Introduction
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-gray-700">
                I&rsquo;ve just finished the first version of a book about what
                happens to humans when intelligence and effort become cheap.
                I&rsquo;ll send you the Introduction right away, and a few pieces
                as I take it toward publication on {LAUNCH_DATE_LABEL}.
            </p>
            <FollowAlongForm
                formId="footer-signup"
                action={MAILERLITE_FORM_ACTION}
                contactEmail="marcel@samyn.co"
                client:visible
            />
        </section>
    </main>

    <Footer />
</Layout>
