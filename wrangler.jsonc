{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "kalon-solutions",
	"compatibility_date": "2026-01-15",
	"main": "./src/worker.ts",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": false }
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/sacred-struggle/thanks", "/sacred-struggle/thanks/",
			"/sacred-struggle/download", "/sacred-struggle/download/",
			"/api/sacred-struggle/stripe", "/api/sacred-struggle/stripe/"
		]
	},
	"ratelimits": [{ "name": "EBOOK_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
	"r2_buckets": [{ "binding": "EBOOK_FILES" }],
	"send_email": [{ "name": "EBOOK_EMAIL", "allowed_sender_addresses": ["downloads@shop.kalon.solutions"] }]
}
